<group name="regis,orchestration,security_telemetry,">

  <!--
    1. Base Rule
    Catch JSON records generated by Regis scanner orchestrators.
    Normal Unified Security Findings and scanner refresh control events
    both contain tenant_code.
  -->
  <rule id="100500" level="3">
    <decoded_as>json</decoded_as>
    <field name="tenant_code">^\w+</field>
    <description>Regis Security: Orchestrator telemetry received from engine [$(engine_source)].</description>
    <options>no_full_log</options>
  </rule>

  <!-- 2a. High Severity Finding -->
  <rule id="100501" level="8">
    <if_sid>100500</if_sid>
    <field name="severity_level">^HIGH$</field>
    <description>Regis Security: High severity finding detected by $(engine_source) on host $(target_host): $(finding_title)</description>
    <group>vulnerability,pci_dss_6.2,</group>
  </rule>

  <!-- 2b. Critical Severity Finding -->
  <rule id="100502" level="10">
    <if_sid>100500</if_sid>
    <field name="severity_level">^CRITICAL$</field>
    <description>Regis Security: Critical vulnerability detected by $(engine_source) on host $(target_host): $(finding_title)</description>
    <group>vulnerability,pci_dss_6.2,</group>
  </rule>

  <!-- 3. Compliance Drift Finding -->
  <rule id="100503" level="7">
    <if_sid>100500</if_sid>
    <field name="finding_category">^compliance_drift$</field>
    <description>Regis Security: Compliance drift flagged by $(engine_source) on host $(target_host) for control $(finding_key).</description>
    <group>compliance_audit,</group>
  </rule>

    <!--
    3b. Compliance Drift Recovery

    Some legitimate Regis SCA findings contain phrases such as
    "login failure" inside descriptive/remediation metadata. Wazuh's
    generic native syslog rule 2501 can therefore match before the
    normal Regis 100500 -> 100503 chain becomes the final alert.

    Recover only decoded Regis compliance findings that have already
    matched native rule 2501.
  -->
  <rule id="100507" level="7">
    <if_sid>2501</if_sid>
    <field name="tenant_code">^\w+</field>
    <field name="engine_source">^wazuh_sca$</field>
    <field name="finding_category">^compliance_drift$</field>
    <description>Regis Security: Compliance drift recovered from native authentication rule collision on host $(target_host) for control $(finding_key).</description>
    <group>compliance_audit,regis_rule_collision_recovery,</group>
  </rule>

  <!-- 4a. Integrity Drift Finding -->
  <rule id="100504" level="12">
    <if_sid>100500</if_sid>
    <field name="finding_category">^integrity_drift$</field>
    <description>Regis Security ALERT: File integrity drift detected on host $(target_host) via $(engine_source).</description>
    <group>system_integrity,intrusion_detection,</group>
  </rule>

  <!-- 4b. Rootkit Finding -->
  <rule id="100505" level="12">
    <if_sid>100500</if_sid>
    <field name="finding_category">^rootkit$</field>
    <description>Regis Security ALERT: Rootkit indicator detected on host $(target_host) via $(engine_source).</description>
    <group>system_integrity,intrusion_detection,</group>
  </rule>

  <!--
    5. Scanner Refresh Completion Control Event

    This is NOT a Unified Security Finding.
    Its purpose is to pass authoritative scanner-refresh state to the
    existing custom-security-findings integration.

    The enrichment worker detects event_type before Unified Finding
    validation and bypasses Ollama enrichment.
  -->
  <rule id="100506" level="3">
    <if_sid>100500</if_sid>
    <field name="event_type">^scanner_refresh_complete$</field>
    <description>Regis Security: Scanner refresh completed for $(engine_source), subject $(scanner_subject_id), refresh $(refresh_id).</description>
    <group>regis_scanner_refresh,</group>
  </rule>

</group>
