[Unit]
Description=Automated Remediation Controller API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple

WorkingDirectory=/opt/automated-remediation

EnvironmentFile=/etc/remediation-controller.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/automated-remediation

ExecStart=/opt/automated-remediation/venv/bin/python -m remediation.controller_api

Restart=on-failure
RestartSec=5

TimeoutStartSec=30
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
