[Unit]
Description=Automated Remediation Controller API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=automated-remediation
Group=automated-remediation

WorkingDirectory=/opt/automated-remediation

Environment=CONTROLLER_HOST=127.0.0.1
Environment=CONTROLLER_PORT=9000
EnvironmentFile=/etc/remediation-controller.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/automated-remediation

ExecStart=/opt/automated-remediation/venv/bin/gunicorn --bind ${CONTROLLER_HOST}:${CONTROLLER_PORT} --workers 2 --timeout 1900 remediation.controller_api:app

Restart=on-failure
RestartSec=5

TimeoutStartSec=30
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
