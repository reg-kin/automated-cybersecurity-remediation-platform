[Unit]
Description=Automated Remediation Scan Policy Administrative API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=automated-remediation
Group=automated-remediation

WorkingDirectory=/opt/automated-remediation

EnvironmentFile=/etc/scan-policy-admin-api.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/automated-remediation

ExecStart=/opt/automated-remediation/venv/bin/gunicorn --bind 127.0.0.1:9102 --workers 2 --timeout 30 scan_policy_administration.api:app

Restart=on-failure
RestartSec=5

TimeoutStartSec=30
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
