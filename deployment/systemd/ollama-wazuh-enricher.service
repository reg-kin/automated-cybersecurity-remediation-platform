[Unit]
Description=Ollama Log Enrichment Worker (VPS Ingestion)
After=network.target redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/automated-remediation/worker
ExecStart=/usr/bin/rq worker ai-enrichment --path /opt/automated-remediation
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
