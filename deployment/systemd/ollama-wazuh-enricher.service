[Unit]
Description=Ollama Log Enrichment Worker (VPS Ingestion)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=automated-remediation
Group=automated-remediation
EnvironmentFile=/etc/remediation-rq-worker.env
WorkingDirectory=/opt/automated-remediation/worker
ExecStart=/opt/automated-remediation/venv/bin/rq worker ai-enrichment --path /opt/automated-remediation
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
