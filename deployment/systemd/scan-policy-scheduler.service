[Unit]
Description=Automated Remediation Scan Policy Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=automated-remediation
Group=automated-remediation

EnvironmentFile=/etc/scan-policy-scheduler.env
Environment=PYTHONPATH=/opt/automated-remediation

WorkingDirectory=/opt/automated-remediation

ExecStart=/opt/automated-remediation/venv/bin/python /opt/automated-remediation/scan_coordination/scheduler_runner.py --loop

Restart=on-failure
RestartSec=10

TimeoutStopSec=30
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
