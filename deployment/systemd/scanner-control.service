[Unit]
Description=Scanner Refresh Control Worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=automated-remediation
Group=automated-remediation
EnvironmentFile=/etc/remediation-rq-worker.env
WorkingDirectory=/opt/automated-remediation/worker
ExecStart=/opt/automated-remediation/venv/bin/rq worker scanner-control --path /opt/automated-remediation
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
