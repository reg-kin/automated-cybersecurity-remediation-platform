[Unit]
Description=Scanner Refresh Control Worker
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/automated-remediation/worker
ExecStart=/usr/bin/rq worker scanner-control --path /opt/automated-remediation
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
