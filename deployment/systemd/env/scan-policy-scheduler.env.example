# PostgreSQL connection used by remediation.shared.db.connect().
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DBNAME=security_portal
PG_USER=telemetry_admin

# Required in the deployed /etc/scan-policy-scheduler.env.
# Leave this example blank; do not commit the production database password.
PG_PASSWORD=

# Maximum number of policy occurrences materialised in one poll cycle.
SCAN_SCHEDULER_BATCH_SIZE=50

# Seconds between scheduler poll cycles.
SCAN_SCHEDULER_POLL_SECONDS=15

# Python logging level.
SCAN_SCHEDULER_LOG_LEVEL=INFO
