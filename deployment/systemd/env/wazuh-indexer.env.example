# Wazuh vulnerability orchestrator
#
# Recommended deployment:
# Run the orchestrator on the Wazuh Manager or another trusted host
# with private/local access to the Wazuh Indexer.

# HTTPS is mandatory.
WAZUH_INDEXER_URL=https://127.0.0.1:9200

# Optional CA bundle for an internal/private Wazuh Indexer CA.
# When omitted, the system trust store is used.
# WAZUH_INDEXER_CA_BUNDLE=/etc/ssl/certs/wazuh-indexer-ca.pem

WAZUH_INDEXER_USER=CHANGE_ME
WAZUH_INDEXER_PASSWORD=CHANGE_ME
