# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DBNAME=security_portal
PG_USER=CHANGE_ME
PG_PASSWORD=CHANGE_ME

# Remediation Controller API
CONTROLLER_HOST=127.0.0.1
CONTROLLER_PORT=9000
CONTROLLER_TOKEN=CHANGE_ME

# Ansible Runner
ANSIBLE_RUNNER_URL=http://127.0.0.1:8081/run
ANSIBLE_RUNNER_TOKEN=CHANGE_ME
ANSIBLE_RUNNER_TIMEOUT=600

# Stage 2 Verification Gateway
VERIFICATION_URL=http://127.0.0.1:18091/verify
VERIFICATION_TOKEN=CHANGE_ME
VERIFICATION_TIMEOUT=1800

# Test-only setting. Keep false in production.
TEST_SKIP_STAGE2=false
