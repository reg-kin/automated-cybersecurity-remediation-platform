# PostgreSQL
REGIS_PG_HOST=127.0.0.1
REGIS_PG_PORT=5432
REGIS_PG_DBNAME=security_portal
REGIS_PG_USER=CHANGE_ME
REGIS_PG_PASSWORD=CHANGE_ME

# Remediation Controller API
REGIS_CONTROLLER_HOST=127.0.0.1
REGIS_CONTROLLER_PORT=9000
REGIS_CONTROLLER_TOKEN=CHANGE_ME

# Ansible Runner
REGIS_ANSIBLE_RUNNER_URL=http://127.0.0.1:8081/run
REGIS_ANSIBLE_RUNNER_TOKEN=CHANGE_ME
REGIS_ANSIBLE_RUNNER_TIMEOUT=600

# Stage 2 Verification Gateway
VERIFICATION_URL=http://127.0.0.1:18091/verify
VERIFICATION_TOKEN=CHANGE_ME
VERIFICATION_TIMEOUT=1800

# Test-only setting. Keep false in production.
REGIS_TEST_SKIP_STAGE2=false
