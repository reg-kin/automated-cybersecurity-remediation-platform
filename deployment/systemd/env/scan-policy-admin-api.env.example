# Scan Policy Administration API
# Install as /etc/scan-policy-admin-api.env
# Restrict access to the service account and administrators.
# Never commit real credentials.

# PostgreSQL connection
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DBNAME=security_portal
PG_USER=CHANGE_ME
PG_PASSWORD=CHANGE_ME

# API listener (loopback only)
SCAN_POLICY_ADMIN_HOST=127.0.0.1
SCAN_POLICY_ADMIN_PORT=9102

# Required authentication and audit identity
SCAN_POLICY_ADMIN_TOKEN=CHANGE_ME
SCAN_POLICY_ADMIN_PRINCIPAL=CHANGE_ME
