VERIFICATION_HOST=0.0.0.0
VERIFICATION_PORT=8090
VERIFICATION_TOKEN=CHANGE_ME

SCANNER_VERIFY_TIMEOUT=1800

# Wazuh Manager API used by the SCA orchestrator.
# HTTPS is mandatory.
WAZUH_API_URL=https://wazuh-manager.example.test:55000

# Optional CA bundle for an internal/private Wazuh Manager CA.
# When omitted, the system trust store is used.
# WAZUH_API_CA_BUNDLE=/etc/ssl/certs/wazuh-api-ca.pem

NUCLEI_BINARY=/usr/bin/nuclei
TRIVY_BINARY=/usr/bin/trivy
NMAP_BINARY=/usr/bin/nmap

OPENVAS_ORCHESTRATOR=/opt/automated-remediation/scanner_orchestrators/openvas_orchestrator.py
NMAP_NSE_ORCHESTRATOR=/opt/automated-remediation/scanner_orchestrators/nmap_orchestrator.py
WAZUH_SCA_ORCHESTRATOR=/opt/automated-remediation/scanner_orchestrators/wazuh_sca_orchestrator.py
LYNIS_ORCHESTRATOR=/opt/automated-remediation/scanner_orchestrators/lynis_orchestrator.py
NUCLEI_ORCHESTRATOR=/opt/automated-remediation/scanner_orchestrators/nuclei_orchestrator.py
TRIVY_ORCHESTRATOR=/opt/automated-remediation/scanner_orchestrators/trivy_orchestrator.py
