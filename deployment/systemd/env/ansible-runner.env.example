# Match the controller URL and token. Configure a reviewed playbook allowlist.
ANSIBLE_RUNNER_HOST=127.0.0.1
ANSIBLE_RUNNER_PORT=8081
ANSIBLE_RUNNER_TOKEN=CHANGE_ME
ANSIBLE_PLAYBOOK_DIR=/opt/automated-remediation/ansible/playbooks
ALLOWED_PLAYBOOKS=CHANGE_ME
ANSIBLE_TIMEOUT=1800
# Provision SSH known_hosts and credentials for the service identity separately.
ANSIBLE_HOST_KEY_CHECKING=True
