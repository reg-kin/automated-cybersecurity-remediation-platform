# ---------------------------------------------------------------------------
# Automated Remediation - n8n / Ansible Runner
# ---------------------------------------------------------------------------

# n8n
#
# Add the n8n settings required by your deployment here.
# Do not commit production credentials.

# Ansible Runner API authentication
ANSIBLE_RUNNER_TOKEN=CHANGE_ME

# Ansible Runner SSH material
#
# Host directory containing only the SSH material required by the Runner:
# config, known_hosts and the remediation identity key.
#
# The directory and private files must be readable by the Runner container
# account (UID/GID 10001) and should not contain unrelated host SSH material.
ANSIBLE_RUNNER_SSH_DIR=/path/to/ansible-runner-ssh
